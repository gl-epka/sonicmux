{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Local IPC required by the SonicMux main window",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "allow-bootstrap",
    "allow-pick-inputs",
    "allow-pick-output-directory",
    "allow-remove-items",
    "allow-set-item-enabled",
    "allow-update-settings",
    "allow-start-batch",
    "allow-cancel-batch",
    "allow-retry-items",
    "allow-choose-ffmpeg",
    "allow-retry-toolchain"
  ]
}
